{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/.git/**", "**/.github/**", "**/node_modules/**", "*.md", "README.txt"],
    "headers": [
      { "source": "**/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
